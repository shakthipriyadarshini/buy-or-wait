# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).
# Everything here is optional — with no .env at all, the app falls back to
# the committed response cache, then to a deterministic mock.

# Free key from https://aistudio.google.com/apikey (no credit card).
GEMINI_API_KEY=

# Model to use. Flash-Lite variants get a higher free-tier quota than the
# newest preview Flash models. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash-lite

# Requests per minute to self-throttle to. Check your real quota at
# https://aistudio.google.com/rate-limit and raise this if it's higher.
GEMINI_RPM_LIMIT=5

# Hard per-call deadline in seconds, enforced outside the SDK.
GEMINI_TIMEOUT_SECS=30

# Where the CSVs live, relative to repo root.
DATASET_DIR=dataset

# Port the API listens on. Most hosts inject this automatically.
PORT=5000

# Comma-separated allowed origins for CORS. "*" is fine for local dev;
# set your real frontend URL in production.
CORS_ORIGINS=*
